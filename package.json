{
  "name": "mash",
  "productName": "Mash",
  "version": "1.0.0",
  "description": "Mash — Autonomous Financial Forensic Auditor",
  "homepage": "https://mash.ai",
  "author": {
    "name": "Mash Team",
    "email": "support@mash.ai"
  },
  "main": "electron/main.js",
  "scripts": {
    "electron:dev": "electron electron/main.js",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "python -m PyInstaller connector/connector.spec --distpath dist/bin --clean -y",
    "build:desktop": "npm run build:frontend && npm run build:backend && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.mash.desktop",
    "productName": "Mash",
    "protocols": [
      {
        "name": "Mash Protocol",
        "schemes": ["mash"]
      }
    ],
    "electronLanguages": ["en-US", "en"],
    "asar": true,
    "directories": {
      "output": "dist/release"
    },
    "files": [
      "electron/**/*",
      "frontend/out/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/bin/connector",
        "to": "bin/connector",
        "filter": [
          "**/*"
        ]
      }
    ],
    "artifactName": "Mash-Setup-${version}.${ext}",
    "publish": {
      "provider": "generic",
      "url": "https://download.mash.ai"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mash",
      "uninstallDisplayName": "Mash"
    }
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0"
  }
}
