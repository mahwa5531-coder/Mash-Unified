# ====================================================================
# MASH Desktop Agent Configuration (.env.example)
# ====================================================================

# Environment mode:
# Set MASH_ENV='development' to bypass login for offline local testing.
# Set MASH_ENV='production' to enforce Cloud Google OAuth & Gateway routing.
MASH_ENV=development
MASH_BYPASS_AUTH=true

# Cloud Gateway Endpoint (Used when connecting to Cloud API Layer)
# CLOUD_GATEWAY_URL=https://api.mash.ai/v1

# Local / Direct LLM Endpoint (Fallback when running without Cloud API)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=mash/auto
LLM_API_KEY=mock-dev-key
LLM_API_TYPE=openai_chat_completion

# Optional timeouts in seconds
LLM_TIMEOUT=300.0
LLM_STREAM_IDLE_TIMEOUT=180.0
