# NexaU Cloud API — environment template.
# Copy to .env, fill values. NEVER commit real secrets.

# --- Core (required) ---------------------------------------------------------
NEXAU_DATABASE_URL=postgres://nexau:password@localhost:5432/nexau?sslmode=require
NEXAU_REDIS_URL=redis://localhost:6379/0
NEXAU_BIFROST_URL=http://localhost:8081

# Bifrost credential — cloud-side only, never returned to any client.
NEXAU_BIFROST_API_KEY=
# Secret-file variant (takes precedence; Docker/k8s secret mounts):
# NEXAU_BIFROST_API_KEY_FILE=/run/secrets/bifrost_api_key

# --- HTTP server ---------------------------------------------------------------
NEXAU_HTTP_ADDR=:8080
NEXAU_SHUTDOWN_GRACE=30s
NEXAU_MAX_CONCURRENT_REQUESTS=8192
NEXAU_MAX_BODY_BYTES=2097152
# Comma-separated CORS/WS origin allow-list (native desktop clients need none):
# NEXAU_ALLOWED_ORIGINS=https://desktop.nexau.cloud

# --- Authentication ------------------------------------------------------------
# local (this API mints HS256 tokens) | jwks (external IdP)
NEXAU_AUTH_MODE=local
# ≥32 bytes in local mode:  openssl rand -hex 32
# SECURITY: never commit this value; compose refuses to start without it.
NEXAU_AUTH_HS256_SECRET=
# Secret-file variant (takes precedence; Docker/k8s secret mounts):
# NEXAU_AUTH_HS256_SECRET_FILE=/run/secrets/hs256_secret
# JWKS mode:
# NEXAU_AUTH_JWKS_URL=https://auth.nexau.cloud/.well-known/jwks.json
NEXAU_AUTH_ISSUER=https://auth.nexau.cloud
NEXAU_AUTH_AUDIENCE=nexau-cloud-api
NEXAU_AUTH_ACCESS_TOKEN_TTL=15m
NEXAU_AUTH_REFRESH_TOKEN_TTL=720h
NEXAU_AUTH_REVOCATION_CHECK=true

# --- Signup & account recovery (local auth mode only) ---------------------------
# Self-serve signup + email verification + password reset (auto-disabled in jwks mode).
NEXAU_AUTH_SIGNUP_ENABLED=true
# Login gate: unverified accounts get 403 EMAIL_NOT_VERIFIED (client shows verify UX).
NEXAU_AUTH_REQUIRE_VERIFIED=true
# Single-use link lifetimes (OWASP: short-lived reset; reset is capped at 1h by validation).
NEXAU_AUTH_VERIFY_TOKEN_TTL=24h
NEXAU_AUTH_RESET_TOKEN_TTL=30m
# Per (purpose,email) send cooldown — bounds email-bombing via resend/forgot.
NEXAU_AUTH_RESEND_COOLDOWN=60s
# NIST 800-63B floor; no composition rules. [8,128].
NEXAU_AUTH_MIN_PASSWORD_LENGTH=8
# Website origin for emailed links (verify/reset pages POST the token back to this API).
# Must be https:// (http allowed only on loopback hosts — config validation).
NEXAU_APP_BASE_URL=https://app.nexau.cloud

# --- Google OAuth ("Continue with Google" on the web login) ----------------------
# All three must be set (and NEXAU_AUTH_MODE=local) to enable the OAuth routes.
# Register the redirect URI in Google Cloud Console → Credentials → OAuth client
# (Web application) — exact match required.
NEXAU_AUTH_GOOGLE_CLIENT_ID=
NEXAU_AUTH_GOOGLE_CLIENT_SECRET=
NEXAU_AUTH_GOOGLE_REDIRECT_URL=https://api.nexau.cloud/v1/auth/oauth/google/callback
# Endpoint overrides (defaults are Google production; tests/air-gapped installs override):
# NEXAU_AUTH_GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# NEXAU_AUTH_GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# NEXAU_AUTH_GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# --- Web-to-desktop handshake (60-second single-use exchange codes) --------------
# Post-OAuth redirect target: the web success page (receives ?grant=wgrant_…).
NEXAU_AUTH_WEB_SUCCESS_URL=https://app.nexau.cloud/auth/success
# OAuth error redirect target (receives ?error=<code>).
NEXAU_AUTH_WEB_LOGIN_URL=https://app.nexau.cloud/auth/login
# Short browser token — NO refresh token is ever issued to a browser. [1m,1h]
NEXAU_AUTH_WEB_SESSION_TTL=15m
# Single-use web grant lifetime. [1m,15m]
NEXAU_AUTH_WEB_GRANT_TTL=5m
# OAuth state lifetime (single-use, tx-cookie bound). [1m,1h]
NEXAU_AUTH_OAUTH_STATE_TTL=10m
# Desktop exchange-code lifetime. [10s,10m]
NEXAU_AUTH_DESKTOP_CODE_TTL=60s
# Secure attribute on the OAuth tx cookie (false only for plain-http dev).
NEXAU_AUTH_OAUTH_COOKIE_SECURE=true
# Handshake throttle budgets (per source IP per 15m, except the per-minute one).
NEXAU_AUTH_LOOKUP_PER_IP=60
NEXAU_AUTH_WEB_SESSION_PER_IP=60
NEXAU_AUTH_DESKTOP_EXCHANGE_PER_IP=60
# Per-user desktop-code mints per minute.
NEXAU_AUTH_DESKTOP_CODE_PER_MIN=30
# Refresh rotation + OAuth begin/callback per source IP per 15m (2026-09-19
# audit, cluster A — these surfaces do PG/Redis work per request).
NEXAU_AUTH_REFRESH_PER_IP=60
NEXAU_AUTH_OAUTH_PER_IP=60
# Unverified local accounts older than this are purged (with their run-less
# personal tenants) by housekeeping — bounds the pre-hijacking seeding window.
NEXAU_AUTH_UNVERIFIED_RETENTION=72h

# --- Mail (transactional: verification + reset emails) ---------------------------
# log: metadata-only events in the structured log (dev/test default; the
#      credential link is NEVER logged unless NEXAU_MAIL_LOG_LINKS=true)
# smtp: stdlib sender, MANDATORY TLS — implicit TLS (465 via NEXAU_SMTP_SSL=true)
#      or required STARTTLS upgrade (587); a relay without STARTTLS is refused.
NEXAU_MAIL_MODE=log
NEXAU_MAIL_FROM=NexaU <no-reply@nexau.cloud>
NEXAU_SMTP_HOST=
NEXAU_SMTP_PORT=587
NEXAU_SMTP_USERNAME=
NEXAU_SMTP_PASSWORD=
NEXAU_SMTP_SSL=false
# DEV ONLY: include live credential links in log-mode mail events (local
# convenience — never enable where logs are collected/shipped).
NEXAU_MAIL_LOG_LINKS=false

# --- Timeouts (separate concepts; never one global) -----------------------------
NEXAU_STREAM_IDLE_TIMEOUT=300s
NEXAU_STREAM_MAX_DURATION=15m
NEXAU_BIFROST_REQUEST_TIMEOUT=120s
NEXAU_BIFROST_DIAL_TIMEOUT=10s
NEXAU_DB_TIMEOUT=5s
NEXAU_REDIS_TIMEOUT=500ms

# --- Upstream circuit breaker (Bifrost path) ------------------------------------
# Trips after 10 consecutive gateway faults OR a >=60% failure rate over the
# last 60 outcomes (once >=30 samples exist). While open: 503
# UPSTREAM_CIRCUIT_OPEN with retry_after_ms, zero upstream traffic. Cooldown
# doubles per repeated trip up to 5m; after it elapses, up to 3 concurrent
# probes test recovery (first success closes the circuit).
NEXAU_BIFROST_CB_ENABLED=true
NEXAU_BIFROST_CB_CONSECUTIVE=10
NEXAU_BIFROST_CB_WINDOW=60
NEXAU_BIFROST_CB_MIN_SAMPLES=30
NEXAU_BIFROST_CB_FAILURE_RATE=0.60
NEXAU_BIFROST_CB_OPEN_BASE=30s
NEXAU_BIFROST_CB_OPEN_MAX=5m
NEXAU_BIFROST_CB_HALFOPEN_PROBES=3

# --- Rate limiting (distributed, Redis-backed) -----------------------------------
NEXAU_RATE_REQ_PER_MIN_USER=600
NEXAU_RATE_REQ_PER_MIN_TENANT=6000
NEXAU_RATE_CONCURRENT_RUNS_USER=16
NEXAU_RATE_CONCURRENT_RUNS_TENANT=256
NEXAU_RATE_WS_CONNS_PER_USER=8
NEXAU_RATE_FAIL_OPEN=true

# --- Streaming / replay ----------------------------------------------------------
NEXAU_REPLAY_MAX_EVENTS=2048
NEXAU_REPLAY_WINDOW=15m

# --- Metering ---------------------------------------------------------------------
NEXAU_METER_QUEUE_SIZE=16384
NEXAU_METER_BATCH_SIZE=128
NEXAU_METER_FLUSH_INTERVAL=500ms

# --- Observability ------------------------------------------------------------------
NEXAU_LOG_LEVEL=info
NEXAU_LOG_FORMAT=json
# Comma-separated extra redaction keys:
# NEXAU_LOG_REDACT_KEYS=tenant_settings
NEXAU_OTEL_SERVICE_NAME=nexau-cloud-api
NEXAU_OTEL_PROMETHEUS=true
# NEXAU_OTEL_TRACE_ENDPOINT=http://otel-collector:4318/v1/traces
# NEXAU_OTEL_METRIC_ENDPOINT=http://otel-collector:4318/v1/metrics
# NEXAU_OTEL_TRACE_RATIO=0.1

# --- Payments: prepaid credit top-ups (docs/PAYMENT-GATEWAY.md) --------------------
# Provider: disabled (default; routes answer 503) | mock (dev, no keys,
# orders self-capture after NEXAU_PAYMENT_MOCK_AUTOCAPTURE) | razorpay
NEXAU_PAYMENT_PROVIDER=disabled

# Razorpay Dashboard → Settings → API Keys → "Test" mode pair.
# The key id looks like rzp_test_XXXXXXXXXXXX (live: rzp_live_...).
NEXAU_RAZORPAY_KEY_ID=
NEXAU_RAZORPAY_KEY_SECRET=

# SEPARATE secret: Dashboard → Settings → Webhooks (create a webhook to
# <your-public-base>/v1/payments/webhook and copy its secret). NOT the key
# secret above — mixing them up is the #1 webhook 401 cause.
NEXAU_RAZORPAY_WEBHOOK_SECRET=

# Optional overrides (tests/proxies only):
# NEXAU_RAZORPAY_API_BASE=https://api.razorpay.com/v1
# Custom packs (JSON): [{"id":"pack_x","label":"X — ₹999","amount_paise":99900,"credits":9990}]
# NEXAU_PAYMENT_CATALOG_JSON=
# NEXAU_PAYMENT_ORDER_TTL=15m
# NEXAU_PAYMENT_SWEEP_INTERVAL=1m
# NEXAU_PAYMENT_CHECKOUT_PER_USER=20
# NEXAU_PAYMENT_WEBHOOK_PER_IP=120
# NEXAU_PAYMENT_MOCK_AUTOCAPTURE=3s
