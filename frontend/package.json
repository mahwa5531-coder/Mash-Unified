{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run copy:monaco && next dev",
    "build": "npm run copy:monaco && tsc --noEmit && next build",
    "start": "next start",
    "lint": "eslint src",
    "test:chat": "npx tsx --tsconfig tsconfig.json tests/test_chat_scenarios.mjs",
    "test:lessons": "npx tsx --tsconfig tsconfig.json tests/test_three_lessons_and_steering.mjs",
    "test:sidebar": "node tests/test_right_sidebar_logic.cjs",
    "test:fuzz": "npx tsx --tsconfig tsconfig.json tests/fuzz_session_store.ts",
    "test:matrix": "npx tsx --tsconfig tsconfig.json tests/test_frontend_complete_matrix.ts",
    "test:chat-matrix": "npx tsx --tsconfig tsconfig.json tests/test_chat_rendering_deep_matrix.ts",
    "test:senior": "npx tsx --tsconfig tsconfig.json tests/senior_challenger_full_spectrum.ts",
    "test:hero": "node tests/test_project_scope_selector.mjs",
    "test:hero:e2e": "node ../tests/test_live_ui_real_scenarios.js",
    "test:electron": "node tests/test_electron_pdf_wiring.mjs",
    "test:drop": "node tests/test_desktop_native_drop_wiring.mjs",
    "test:tool-render": "node tests/test_production_tool_rendering.mjs && npx tsx tests/test_tool_permission_scenarios_and_lifecycle.mjs",
    "test:perf": "npx tsx tests/test_virtualized_desktop_optimizations.mjs && npx tsx tests/test_ram_memory_and_virtualization_coverage.mjs",
    "test:e2e": "playwright test",
    "test:virtuoso": "npx tsx --tsconfig tsconfig.json tests/test_virtuoso_chat_contracts.ts",
    "test:artifacts": "npx tsx --tsconfig tsconfig.json tests/test_paths_and_artifacts_classification.ts",
    "test:scenarios": "npx tsx --tsconfig tsconfig.json tests/test_pending_frontend_scenarios.ts",
    "test:stress": "npx tsx --tsconfig tsconfig.json tests/test_1000_turn_scroll_and_ram_matrix.ts",
    "test:50k": "npx tsx --tsconfig tsconfig.json tests/test_50k_steps_and_multi_session_ram.ts",
    "test": "node scripts/run-all-tests.mjs",
    "copy:monaco": "node -e \"const fs=require('fs'),p=require('path'); if (!fs.existsSync('public/monaco/vs')) { fs.mkdirSync('public/monaco', {recursive:true}); fs.cpSync('node_modules/monaco-editor/min/vs', 'public/monaco/vs', {recursive:true, filter:(s)=>{const n=s.split(p.sep).join('/'); return !n.includes('/nls/lang') && !(n.includes('/language/') && n.endsWith('.worker.js'));}}); }\""
  },
  "dependencies": {
    "@extend-ai/react-xlsx": "^0.23.0",
    "@monaco-editor/react": "^4.7.0",
    "@panzoom/panzoom": "^4.6.2",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@streamdown/math": "^1.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.18.7",
    "lucide-react": "^1.28.0",
    "monaco-editor": "^0.57.0",
    "next": "16.2.12",
    "pele": "^1.13.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-virtuoso": "^4.18.20",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "fast-check": "^4.10.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
