# ====================================================================
# MASH Connector Configuration (.env.example)
# ====================================================================
MASH_ENV=development
MASH_BYPASS_AUTH=true

# Local / Direct LLM Endpoint
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=mash/auto
LLM_API_KEY=mock-dev-key
LLM_API_TYPE=openai_chat_completion

# Optional timeouts in seconds
LLM_TIMEOUT=300.0
LLM_STREAM_IDLE_TIMEOUT=180.0
